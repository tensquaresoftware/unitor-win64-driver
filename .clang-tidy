# unitor-win64-driver quality gate — mechanical thresholds (see conventions.md §3).
# Primary day-to-day gate: scripts/quality/lint-touched.py (git diff).
# This file aligns clang-tidy / IDE analysis with the same numbers.
#
# Hot MIDI/USB path: timing safety beats aesthetics. Prefer a dated NOLINT with motive
# over fragmenting a latency-sensitive callback for the linter.

Checks: >
  -*,
  readability-function-size,
  readability-function-cognitive-complexity

HeaderFilterRegex: 'src/.*'

WarningsAsErrors: ''

CheckOptions:
  # ~50 lines covers platform/WinUSB glue; core/protocol should stay nearer ~40 (script enforces path-aware limits).
  - key: readability-function-size.LineThreshold
    value: '50'
  - key: readability-function-size.StatementThreshold
    value: '4294967295'
  - key: readability-function-size.BranchThreshold
    value: '4294967295'
  - key: readability-function-size.ParameterThreshold
    value: '4'
  - key: readability-function-size.NestingThreshold
    value: '4'
  - key: readability-function-size.VariableThreshold
    value: '4294967295'
  - key: readability-function-cognitive-complexity.Threshold
    value: '10'
  - key: readability-function-cognitive-complexity.DescribeBasicIncrements
    value: 'false'
